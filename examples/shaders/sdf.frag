        }
         {
            float dif = sqrt(clampf(0.5 + 0.5 * nor.y, 0.0, 1.0));
            dif *= occ;
            float spe = smoothstep(- 0.2, 0.2, ref.y);
            spe *= dif;
            spe *= 0.04 + 0.96 * pow(clampf(1.0 + dot(nor, rd), 0.0, 1.0), 5.0);
            spe *= calcSoftshadow(pos, ref, 0.02, 2.5);
            lin += col * vec3(0.40, 0.60, 1.15) * (0.60 * dif);
            lin += vec3(0.40, 0.60, 1.30) * (2.00 * spe * ks);
        }
         {
            float dif = clampf(dot(nor, normalize(vec3(0.5, 0.0, 0.6))), 0.0, 1.0) * clampf(1.0 - pos.y, 0.0, 1.0);
            dif *= occ;
            lin += col * vec3(0.25, 0.25, 0.25) * (0.55 * dif);
        }
         {
            float dif = pow(clampf(1.0 + dot(nor, rd), 0.0, 1.0), 2.0);
            dif *= occ;
            lin += col * (0.25 * dif);
        }
        col = lin;
        col = mix(col, vec3(0.7, 0.7, 0.9), 1.0 - exp(- 0.0001 * t * t * t));
    }
    return clampv(col, 0.0, 1.0);
}

const float kFocal = 2.5;
vec3 rayDir(vec2 p) {
    vec3 d = normalize(vec3(p.x, p.y, kFocal));
    return u.cu * d.x + u.cv * d.y + u.cw * d.z;
}

void main() {
    vec2 p = {
        v_ndc.x * u.aspect, v_ndc.y
    }
    ;
    const float px = 2.0 / 540.0;
    vec3 rd = rayDir(p);
    vec3 rdx = rayDir(p + vec2(px, 0.0));
    vec3 rdy = rayDir(p + vec2(0.0, px));
    vec3 col = render(u.ro, rd, rdx, rdy);
    col = powv(col, 0.4545);
    outColor = vec4(col, 1.0);
}
