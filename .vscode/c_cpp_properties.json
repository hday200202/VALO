{
    "configurations": [
        {
            "name": "default",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/ext/stb",
                "${workspaceFolder}/ext/SDL3-install/include",
                "${workspaceFolder}/ext/tinyobjloader",
                "${workspaceFolder}/ext/cgltf",
                "${workspaceFolder}/ext/vma",
                "${workspaceFolder}/ext/vulkan/macOS/include",
                "${workspaceFolder}/ext/vulkan/Include",
                "${workspaceFolder}/ext/vulkan/*/x86_64/include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/examples",
                    "${workspaceFolder}/ext/stb",
                    "${workspaceFolder}/ext/SDL3-install/include",
                    "${workspaceFolder}/ext/tinyobjloader",
                    "${workspaceFolder}/ext/cgltf",
                    "${workspaceFolder}/ext/vma",
                    "${workspaceFolder}/ext/vulkan/macOS/include",
                    "${workspaceFolder}/ext/vulkan/Include",
                    "${workspaceFolder}/ext/vulkan/*/x86_64/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "defines": [
                "VALO_HAS_VULKAN=1"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}
