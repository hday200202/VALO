# valo_embed_shaders(<target> SHADERS a.vert.hpp a.frag.hpp ...)
#
# Compiles each shader to SPIR-V at build time and links it into <target>, so the
# Vulkan backend creates the program from memory: no glslc and no files beside
# the executable at runtime. A path ending in .hpp is a C++ shader whose GLSL
# sits beside it with the .hpp stripped; anything else is GLSL. The GLSL has to
# exist - VALO does not generate it.
#
# In an executable the shaders register themselves. A static library's objects
# are only linked when referenced, so a library target calls the generated index
# once before creating programs, which pulls every embedded shader in:
#
#     VALO_DECLARE_EMBEDDED_SHADERS(mylib)        // at global scope
#     ...
#     VALO_REGISTER_EMBEDDED_SHADERS(mylib);      // before createProgram

set(VALO_EMBED_SPIRV_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/EmbedSpirv.cmake" CACHE INTERNAL "")

function(valo_embed_shaders target)
    cmake_parse_arguments(ARG "" "" "SHADERS;INCLUDES" ${ARGN})

    if(NOT VALO_GLSLC)
        message(FATAL_ERROR "valo_embed_shaders(${target}): glslc not found - fetch the Vulkan SDK with ./build.sh")
    endif()

    # INCLUDES only ever fed the C++ to GLSL translator; still parsed so an old
    # call's directories are not mistaken for shaders
    if(ARG_INCLUDES)
        message(WARNING "valo_embed_shaders(${target}): INCLUDES is ignored - VALO no longer translates shaders")
    endif()

    # C identifiers derived from the target and each shader's file name
    string(MAKE_C_IDENTIFIER "${target}" target_id)
    set(outdir "${CMAKE_CURRENT_BINARY_DIR}/valo_spirv/${target}")
    set(symbols)

    foreach(shader IN LISTS ARG_SHADERS)
        get_filename_component(source "${shader}" ABSOLUTE)

        if(source MATCHES "\\.hpp$")
            string(REGEX REPLACE "\\.hpp$" "" glsl "${source}")
        else()
            set(glsl "${source}")
        endif()

        get_filename_component(name "${glsl}" NAME)
        set(spv "${outdir}/${name}.spv")
        set(cpp "${outdir}/${name}.cpp")
        string(MAKE_C_IDENTIFIER "${name}" name_id)
        set(symbol "valo_spirv_${target_id}_${name_id}")
        list(APPEND symbols "${symbol}")

        if(NOT EXISTS "${glsl}")
            message(FATAL_ERROR "valo_embed_shaders(${target}): no GLSL shader at ${glsl}")
        endif()

        add_custom_command(
            OUTPUT  "${cpp}"
            BYPRODUCTS "${spv}"
            # glslc will not create its output directory, and the Makefile
            # generator does not create it for custom command outputs either
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${outdir}"
            COMMAND "${VALO_GLSLC}" -I "${VALO_SHADER_INCLUDE_DIR}" "${glsl}" -o "${spv}"
            COMMAND "${CMAKE_COMMAND}" -DINPUT=${spv} -DOUTPUT=${cpp} -DKEY=${source} -DSYMBOL=${symbol} -P "${VALO_EMBED_SPIRV_SCRIPT}"
            DEPENDS "${glsl}" "${VALO_SHADER_INCLUDE_DIR}/valo.glsl"
            COMMENT "Embedding ${name}"
            VERBATIM
        )

        target_sources(${target} PRIVATE "${cpp}")
    endforeach()

    # the index a library calls to pull every shader above into the link
    set(index_body "// generated by valo_embed_shaders(${target}) - do not edit\n\n")
    foreach(symbol IN LISTS symbols)
        string(APPEND index_body "void ${symbol}();\n")
    endforeach()
    string(APPEND index_body "\nvoid valo_register_embedded_shaders_${target_id}() {\n")
    foreach(symbol IN LISTS symbols)
        string(APPEND index_body "    ${symbol}();\n")
    endforeach()
    string(APPEND index_body "}\n")

    # written only when the content changes, so it does not force a rebuild
    set(index "${outdir}/embedded_shaders.cpp")
    file(MAKE_DIRECTORY "${outdir}")
    file(CONFIGURE OUTPUT "${index}" CONTENT "${index_body}" @ONLY)
    target_sources(${target} PRIVATE "${index}")
endfunction()
